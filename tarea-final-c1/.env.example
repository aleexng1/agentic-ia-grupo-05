# Copia este archivo como .env y completa los valores en TU computador.
# El archivo .env NUNCA se sube al repositorio (Git lo ignora).

# Clave de Google AI Studio (personal, no la compartas)
GOOGLE_API_KEY=

# Modelo de lenguaje: usa el del curso indicado en README.md (ficha de reproducción)
GEMINI_MODEL=

# Modelo de embeddings para el RAG (ver README.md)
EMBEDDING_MODEL=

# Redis del curso (confirmar con la coordinación qué instancia usar)
REDIS_URL=
# Índice del grupo en Redis (política v1.6, 20 documentos). No es un secreto.
REDIS_PREFIJO=grupo05_v15

# Trazas del agente: 1 = mostrar, 0 = ocultar
MOSTRAR_TRAZAS=
