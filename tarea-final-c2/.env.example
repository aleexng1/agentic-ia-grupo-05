# Copia este archivo como .env y completa los valores EN TU COMPUTADOR.
# El .env NUNCA se sube al repositorio (Git lo ignora). En Heroku van como Config Vars.
# Todos los valores de abajo son FICTICIOS o de ejemplo.

# --- Modelos ---------------------------------------------------------------
# Clave personal de Google AI Studio (Gemini). No la compartas.
GOOGLE_API_KEY=pon_tu_clave_aqui
# Modelo que usa el agente principal (y el verificador para leer la boleta).
MODELO_PRINCIPAL=gemini-3.5-flash-lite
# Modelo al que se cambia si el principal falla (cuota, 503, timeout). Vacío = sin respaldo.
MODELO_RESPALDO=modelo-de-respaldo-del-curso
# Modelo de embeddings del RAG (el mismo con que se cargó el índice de Redis).
EMBEDDING_MODEL=modelo-de-embeddings-del-curso

# --- Seguridad -------------------------------------------------------------
# Clave que el cliente manda en la cabecera X-API-Key para usar /chat y /registro.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_SERVICIO=cambia-esta-clave-de-ejemplo
# Token compartido entre el principal y el verificador para el canal A2A.
TOKEN_A2A=cambia-este-token-de-ejemplo

# --- A2A (verificador de boletas) ------------------------------------------
# Dirección del verificador, sin barra final (en local, otra terminal en el puerto 8001).
URL_VERIFICADOR=http://127.0.0.1:8001
# Segundos máximos que el principal espera al verificador antes de usar el fallback.
TIMEOUT_A2A_SEG=20
# 1 = simula que el verificador falla (evidencia de "fallo controlado"). Normal: 0.
FORZAR_FALLO_A2A=0

# --- /chat asíncrono --------------------------------------------------------
# Tope global de una ejecución de /chat en segundo plano; si se pasa, queda en "error" sin resultado.
TIEMPO_MAX_EJECUCION_SEG=90
# Ejecuciones de /chat que corren a la vez en el proceso (las demás esperan su turno).
MAX_EJECUCIONES_SIMULTANEAS=4
# Razonamiento interno de Gemini en el router y en el verificador: minimal | low | medium | high | predeterminado.
NIVEL_RAZONAMIENTO=minimal

# --- ReAct -----------------------------------------------------------------
# Máximo de vueltas del ciclo ReAct por turno (condición de parada). 10 si se omite.
MAX_PASOS_REACT=10

# --- Datos -----------------------------------------------------------------
# Postgres: tabla ejecuciones, registro de veredictos y memoria. Heroku la crea sola.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/tarea_final_c2
# Redis del curso para el RAG de la política.
REDIS_URL=redis://usuario:contrasena@host-de-ejemplo:6379
# Índice del grupo en Redis (no es secreto; el de tarea-final-c1 es grupo05_v15).
REDIS_PREFIJO=grupo05_v15
# Neo4j para el GraphRAG (cargo → nivel → categoría → tope).
NEO4J_URI=neo4j+s://instancia-de-ejemplo.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=contrasena-de-ejemplo

# --- n8n (ampliación de respaldo: caso A2A adicional, no reemplaza al verificador) ---
N8N_WEBHOOK_URL=https://instancia-de-ejemplo.app.n8n.cloud/webhook/caso-adicional

# --- Despliegue ------------------------------------------------------------
# Qué app levanta el Procfile:  api.app:app (principal)  o  src.verificador.app:app
APP_MODULE=api.app:app

# --- Desarrollo ------------------------------------------------------------
# Trazas del ReAct en la terminal: 1 = mostrar, 0 = ocultar.
MOSTRAR_TRAZAS=1
