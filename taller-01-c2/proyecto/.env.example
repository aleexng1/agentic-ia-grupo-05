# Clave de Gemini; copia este archivo a .env y pega allí tu clave.
GOOGLE_API_KEY=
# Modelo de Gemini que usará el proyecto.
MODELO=gemini-3.5-flash-lite
# Dirección donde escuchará el coordinador.
URL_COORDINADOR=http://127.0.0.1:8002
# Dirección donde escuchará mi agente de programa (Matias).
URL_MATIAS=http://127.0.0.1:8003
# Dirección donde escuchará el agente de lugares y capacidad (Alex).
URL_ALEX=http://127.0.0.1:8004
# Dirección donde escuchará el agente de presupuesto y costos (Eduardo).
URL_EDUARDO=http://127.0.0.1:8005
# Dirección donde escuchará el agente de comida y catering (Sebastián).
URL_SEBASTIAN=http://127.0.0.1:8006
# Dirección HTTPS del túnel Cloudflare para publicar mi ficha.
URL_PUBLICA=
# Direcciones HTTPS de los agentes de los compañeros, separadas por comas.
# Orden: Alex, Eduardo, Sebastián (una dirección por cada uno; vacía si aún no existe).
URLS_AGENTES=
