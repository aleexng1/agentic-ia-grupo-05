# Copia este archivo a .env y rellena los valores. Nunca subas .env al repo.
GOOGLE_API_KEY=
MODELO=gemini-3.5-flash-lite
PUBLIC_URL=
# Clave que exige POST /chat en la cabecera X-API-Key.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambia-esto-por-tu-clave
# Token del bot propio del taller; el webhook lo maneja n8n, la API no lo usa.
TELEGRAM_TOKEN=
