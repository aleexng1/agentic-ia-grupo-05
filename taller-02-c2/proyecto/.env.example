# Copia este archivo a .env y completa los valores. El .env nunca se sube al repositorio.

# Clave de Gemini (se obtiene en Google AI Studio).
GOOGLE_API_KEY=
# Modelo de Gemini que usará el proyecto.
MODELO=gemini-3.5-flash-lite
# Puerto local de la app única. El coordinador llama a los agentes por
# http://127.0.0.1:PUERTO/agentes/..., así que debe ser el mismo de uvicorn --port.
# En Heroku manda la variable PORT, que asigna la plataforma.
PUERTO=8000
# Dirección pública de la app, sin barra final. Las fichas de los agentes se publican
# como URL_BASE/agentes/{nombre}. En Heroku: https://NOMBRE-DE-LA-APP.herokuapp.com
URL_BASE=http://127.0.0.1:8000
# Clave de acceso a la API (obligatoria): toda consulta debe enviarla en la cabecera
# X-API-Key. Si está vacía, el servidor avisa al arrancar y rechaza todas las consultas.
# Es distinta de GOOGLE_API_KEY. Elige una larga y al azar; una forma de generarla:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CLAVE_API=
# Agentes que consulta el coordinador, separados por comas.
# Vacío = las cuatro rutas internas de la app única (URL_BASE/agentes/...).
# Con valores se usan solo esas direcciones (modo distribuido: un agente por computador).
URLS_AGENTES=
