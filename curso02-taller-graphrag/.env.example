# Neo4j Aura: datos del .txt que se descarga al crear la instancia
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# En instancias nuevas el usuario NO es "neo4j": es el ID de la instancia
NEO4J_USERNAME=id-de-tu-instancia
NEO4J_PASSWORD=tu-contraseña-de-aura
# Clave de Gemini (Google AI Studio)
GOOGLE_API_KEY=tu-api-key-de-gemini
