# Copia este archivo como .env y completa los valores reales (nunca los subas a git).
GOOGLE_API_KEY=
REDIS_URL=redis://localhost:6379
# Backend vectorial: redis (alternativa: faiss)
VECTOR_STORE=redis
EMBEDDING_MODEL=models/gemini-embedding-001
MODELO=gemini-3.5-flash-lite
# Prefijo del índice: cada equipo usa uno distinto
PREFIJO=equipo1
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=3
UMBRAL=0.65
